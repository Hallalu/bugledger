{
  "name": "bugledger",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bugledger-checks",
      "database_id": "db2e48ed-a2c0-485b-af06-abff6c12555c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SHOTS",
      "bucket_name": "bugledger-shots"
    }
  ],
  "observability": {
    "enabled": true
  }
}
